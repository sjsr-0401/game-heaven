{
  "name": "game-heaven",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "집째로 도망 · 2–4인 협동 액션",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "test": "tsx --test tests/*.test.ts",
    "review": "tsx scripts/review.ts",
    "review:html": "node scripts/build-review.mjs"
  },
  "dependencies": {
    "ws": "^8.22.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "@types/three": "0.180.0"
  }
}
